{
  "info": {
    "name": "LLM API Gateway",
    "description": "OpenAI-compatible collection for gateway :8080 + admin :8081 + pprof :6060. Import to Postman. Set variable gateway_url=http://localhost:8080 admin_key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080" },
    { "key": "admin_url", "value": "http://localhost:8081" },
    { "key": "api_key", "value": "local-dev" },
    { "key": "admin_key", "value": "changeme" }
  ],
  "item": [
    {
      "name": "chat completions",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "body": { "mode": "raw", "raw": "{\"model\":\"claude-sonnet-4-6\",\"messages\":[{\"role\":\"user\",\"content\":\"What is a token bucket?\"}],\"max_tokens\":64}" },
        "url": { "raw": "{{gateway_url}}/v1/chat/completions", "host": ["{{gateway_url}}"], "path": ["v1","chat","completions"] }
      }
    },
    {
      "name": "chat stream",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{api_key}}" }, { "key": "Accept", "value": "text/event-stream" }],
        "body": { "mode": "raw", "raw": "{\"model\":\"gpt-4o\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}" },
        "url": { "raw": "{{gateway_url}}/v1/chat/completions", "host": ["{{gateway_url}}"], "path": ["v1","chat","completions"] }
      }
    },
    {
      "name": "embeddings",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "body": { "mode": "raw", "raw": "{\"model\":\"text-embedding-3-small\",\"input\":\"hello world\"}" },
        "url": { "raw": "{{gateway_url}}/v1/embeddings", "host": ["{{gateway_url}}"], "path": ["v1","embeddings"] }
      }
    },
    {
      "name": "models",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "url": { "raw": "{{gateway_url}}/v1/models", "host": ["{{gateway_url}}"], "path": ["v1","models"] }
      }
    },
    {
      "name": "health",
      "request": { "method": "GET", "url": { "raw": "{{gateway_url}}/health", "host": ["{{gateway_url}}"], "path": ["health"] } }
    },
    {
      "name": "metrics",
      "request": { "method": "GET", "url": { "raw": "{{gateway_url}}/metrics", "host": ["{{gateway_url}}"], "path": ["metrics"] } }
    },
    {
      "name": "admin config",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_key}}" }],
        "url": { "raw": "{{admin_url}}/admin/config", "host": ["{{admin_url}}"], "path": ["admin","config"] }
      }
    },
    {
      "name": "admin reload",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_key}}" }],
        "url": { "raw": "{{admin_url}}/admin/reload", "host": ["{{admin_url}}"], "path": ["admin","reload"] }
      }
    },
    {
      "name": "pprof heap",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_key}}" }],
        "url": { "raw": "http://localhost:6060/debug/pprof/heap", "host": ["http://localhost:6060"], "path": ["debug","pprof","heap"] }
      }
    }
  ]
}
