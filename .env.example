# Provider API keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway auth (optional, leave empty to disable auth for local dev)
GATEWAY_API_KEY=your_gateway_api_key_here

# HMAC-SHA256 pepper for the stored tenant-key hashes. Recommended outside dev;
# changing it invalidates previous hashes (keys are re-hashed on reload).
AUTH_KEY_PEPPER=change_me_to_a_random_32_byte_secret

# Admin API key. Required in production; local dev opts in via admin.allow_insecure.
ADMIN_API_KEY=your_admin_api_key_here

# Redis (optional, for distributed rate limiting and budget; required in strict)
REDIS_URL=redis://localhost:6379/0

# "prod" enables the same strict validation as --strict.
# GATEWAY_ENV=prod
# Replica count; only used to warn when a budget lacks a shared store.
# GATEWAY_REPLICAS=3

# OTEL (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
