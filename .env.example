# Provider API keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway auth (optional, leave empty to disable auth for local dev)
GATEWAY_API_KEY=your_gateway_api_key_here

# Admin API key (protects :8081 and :6060/pprof). Leave empty for local dev (open).
ADMIN_API_KEY=your_admin_api_key_here

# Redis (optional, for distributed rate limiting and budget)
REDIS_URL=redis://localhost:6379/0

# OTEL (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
